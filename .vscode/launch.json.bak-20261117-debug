{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "gdb 调试（读 in.txt）",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "启用 gdb 美化输出（STL 容器可读）",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "按需编译当前文件",
      "customLaunchSetupCommands": [
        {
          "description": "用 in.txt 喂标准输入，直接跑起来",
          "text": "run < ${fileDirname}/in.txt",
          "ignoreFailures": false
        }
      ]
    }
  ]
}