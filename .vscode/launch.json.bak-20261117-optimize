{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "gdb 调试（读 in.txt）",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}.debug",
      "args": [
        "<",
        "${fileDirname}/in.txt"
      ],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "启用 gdb 美化输出（STL 容器可读）",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "按需编译当前文件"
    }
  ]
}
