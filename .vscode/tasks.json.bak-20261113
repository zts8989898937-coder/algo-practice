{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译并运行",
      "type": "shell",
      "command": "g++ -std=c++17 -O2 -g -Wall -Wextra -DLOCAL -o \"${fileDirname}/${fileBasenameNoExtension}\" \"${file}\" && cd \"${fileDirname}\" && ./${fileBasenameNoExtension} < in.txt",
      "options": { "cwd": "${fileDirname}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "shared", "focus": true, "clear": true }
    },
    {
      "label": "编译当前文件",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-O2",
        "-g",
        "-Wall",
        "-Wextra",
        "-DLOCAL",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}",
        "${file}"
      ],
      "options": { "cwd": "${fileDirname}" },
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "运行（读 in.txt）",
      "type": "shell",
      "command": "${fileDirname}/${fileBasenameNoExtension} < ${fileDirname}/in.txt",
      "options": { "cwd": "${fileDirname}" },
      "dependsOn": "编译当前文件",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "focus": true, "clear": true }
    },
    {
      "label": "运行（键盘输入）",
      "type": "shell",
      "command": "${fileDirname}/${fileBasenameNoExtension}",
      "options": { "cwd": "${fileDirname}" },
      "dependsOn": "编译当前文件",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "focus": true, "clear": true }
    },
    {
      "label": "对拍（sol vs brute）",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/tools/stress.sh", "sol.cpp", "brute.cpp"],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "focus": true }
    },
    {
      "label": "计时运行（读 in.txt）",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "time ./${fileBasenameNoExtension} < in.txt"
      ],
      "options": { "cwd": "${fileDirname}" },
      "dependsOn": "编译当前文件",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "focus": true }
    }
  ]
}
